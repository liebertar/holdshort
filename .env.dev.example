# sky-net — shared dev server (for example a Nebius VM).
#
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# Unlike local, no Ollama fleet is assumed: models come from Nebius Token Factory and the
# briefing from Tavily. With the keys left empty the same stack runs on rules only.

# ---- Keys -------------------------------------------------------------------------------
# The Nebius key alone is enough: compose fills in the URL and the model ids.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# ---- Optional ---------------------------------------------------------------------------
# Tavily credits per round (default 20).
#TAVILY_BUDGET_PER_ROUND=20

# Model ids, only to change compose's nvidia/... defaults.
#MODEL_NANO=nvidia/Nemotron-3_5-Lightning
#MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
#MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# ---- Simulation -------------------------------------------------------------------------
# Seconds per tick.
TICK_SECONDS=0.2
